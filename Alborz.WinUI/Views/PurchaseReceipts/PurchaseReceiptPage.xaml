<Page
    x:Class="Alborz.WinUI.Views.PurchaseReceipts.PurchaseReceiptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Alborz.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <AutoSuggestBox Header="Supplier / Party" 
                                Text="{x:Bind ViewModel.SearchSupplierText, Mode=TwoWay}" 
                                ItemsSource="{x:Bind ViewModel.SupplierSearchResults, Mode=OneWay}"
                                TextChanged="SupplierSearchBox_TextChanged"
                                SuggestionChosen="SupplierSearchBox_SuggestionChosen"
                                TextMemberPath="Name" 
                                UpdateTextOnSelect="False"
                                Width="250"
                                PlaceholderText="Type supplier name...">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Phone}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <CalendarDatePicker Header="Receipt Date" 
                                    Date="{x:Bind ViewModel.ReceiptDate, Mode=TwoWay}" 
                                    HorizontalAlignment="Stretch"/>


                <TextBox Header="Reference Number" 
                         Text="{x:Bind ViewModel.ReferenceNumber, Mode=TwoWay}" 
                         Width="150" 
                         PlaceholderText="e.g. INV-1002"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" 
                 Severity="Error" 
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox Grid.Column="0" 
                                Header="Search Product (Code/Name/Barcode)" 
                                Text="{x:Bind ViewModel.SearchProductText, Mode=TwoWay}" 
                                ItemsSource="{x:Bind ViewModel.ProductSearchResults, Mode=OneWay}"
                                TextChanged="ProductSearchBox_TextChanged"
                                SuggestionChosen="ProductSearchBox_SuggestionChosen"
                                TextMemberPath="Name"
                                UpdateTextOnSelect="False"
                                PlaceholderText="Type to search...">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Id}" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <TextBox Grid.Column="1" Header="Qty" Text="{x:Bind ViewModel.InputQuantity, Mode=TwoWay}"/>

                    <TextBox Grid.Column="2" Header="Unit Price" Text="{x:Bind ViewModel.InputPrice, Mode=TwoWay}" TextChanging="Currency_TextChanging"/>

                    <TextBox Grid.Column="3"
                             Header="Discount (%)" 
                             Text="{x:Bind ViewModel.InputDiscountPercentage, Mode=TwoWay}" 
                             TextChanging="NumericOnly_TextChanging"
                             PlaceholderText="e.g. 0, 5, 10"/>

                    <Button Grid.Column="4" Content="Add to List" Command="{x:Bind ViewModel.AddToReceiptCommand}" VerticalAlignment="Bottom" Style="{ThemeResource AccentButtonStyle}" Width="150"/>

                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <controls:DataGrid ItemsSource="{x:Bind ViewModel.ReceiptItems, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" MinWidth="300"/>
                    <controls:DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" MinWidth="80"/>
                    <controls:DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="120" MinWidth="120"/>
                    <controls:DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" Width="120" MinWidth="120"/>
                    <controls:DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="140" MinWidth="140"/>

                    <controls:DataGridTemplateColumn Width="70">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="IndianRed"
                            Click="RemoveItemButton_Click"
                            ToolTipService.ToolTip="Remove item">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>


        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" 
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
        BorderThickness="1" CornerRadius="8" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBox Header="Global Discount" 
                         Text="{x:Bind ViewModel.TotalDiscount, Mode=TwoWay}" 
                         TextChanging="Currency_TextChanging" 
                         Width="180" />

                        <TextBox Header="Additional Charges (Freight, etc.)" 
                         Text="{x:Bind ViewModel.AdditionalCharges, Mode=TwoWay}" 
                         TextChanging="Currency_TextChanging" 
                         Width="220" />
                    </StackPanel>

                    <TextBox Header="Remarks / Notes" 
                     Text="{x:Bind ViewModel.Remarks, Mode=TwoWay}" 
                     Width="416" Height="80" 
                     TextWrapping="Wrap" AcceptsReturn="True"
                     PlaceholderText="Enter any additional notes here..."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">

                    <Grid>
                        <TextBlock Text="Total Amount:" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalAmount,
                            Mode=OneWay,
                            Converter={StaticResource CurrencyConverter}}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   FontSize="14"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Total Line Discounts:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalLineDiscounts, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="IndianRed" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Overall Discount:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.OverallTotalDiscount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="IndianRed" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Additional Charges:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.AdditionalChargesValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="SeaGreen" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>

                    <MenuFlyoutSeparator Margin="0,6" />

                    <Grid>
                        <TextBlock Text="Net Payable:" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.NetAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" 
                            Command="{x:Bind ViewModel.SaveReceiptCommand}" 
                            Style="{ThemeResource AccentButtonStyle}" 
                            HorizontalAlignment="Stretch" 
                            Height="48" Margin="0,12,0,0" 
                            FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>