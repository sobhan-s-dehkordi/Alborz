<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Alborz.WinUI.Views.PurchaseReceipts.PurchaseHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Alborz.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox Grid.Column="0" 
                                Header="Supplier / Party" 
                                Text="{x:Bind ViewModel.SearchSupplierText, Mode=TwoWay}" 
                                ItemsSource="{x:Bind ViewModel.SupplierSearchResults, Mode=OneWay}"
                                TextChanged="SupplierSearchBox_TextChanged"
                                SuggestionChosen="SupplierSearchBox_SuggestionChosen"
                                TextMemberPath="Name"
                                UpdateTextOnSelect="False"
                                PlaceholderText="Search supplier...">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding Phone}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <CalendarDatePicker Grid.Column="1" 
                                    Header="From Date" 
                                    Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select date"/>

                <CalendarDatePicker Grid.Column="2" 
                                    Header="To Date" 
                                    Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" 
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select date"/>

                <TextBox Grid.Column="3" 
                         Header="Reference Number" 
                         Text="{x:Bind ViewModel.ReferenceNumberFilter, Mode=TwoWay}" 
                         PlaceholderText="e.g. INV-123"/>

                <Button Grid.Column="4" 
                        Content="Search" 
                        Command="{x:Bind ViewModel.SearchReceiptsCommand}" 
                        VerticalAlignment="Bottom" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        Width="100"/>
            </Grid>
        </Border>

        <controls:DataGrid Grid.Row="1"
                           ItemsSource="{x:Bind ViewModel.Receipts, Mode=OneWay}"
                           SelectedItem="{x:Bind ViewModel.SelectedReceipt, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           CanUserSortColumns="True"
                           HeadersVisibility="Column"
                           GridLinesVisibility="Horizontal"
                           SelectionMode="Single">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Date" Binding="{Binding ReceiptDate}" Width="120" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Reference No" Binding="{Binding ReferenceNumber}" Width="150" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="150" IsReadOnly="True"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Total Receipts Amount:" FontSize="16" FontWeight="SemiBold" Foreground="Gray"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalAmountSummary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    
                    <Button Content="Export to Excel" 
                            Command="{x:Bind ViewModel.ExportToExcelCommand}" 
                            Style="{ThemeResource AccentButtonStyle}"                            
                            Width="120"/>

                    <Button Content="Details" 
                            Command="{x:Bind ViewModel.ViewDetailsCommand}" 
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsReceiptSelected, Mode=OneWay}"
                            Width="120"/>

                    <Button Content="Edit" 
                            Command="{x:Bind ViewModel.EditReceiptCommand}" 
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsReceiptSelected, Mode=OneWay}"
                            Width="120"/>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>
