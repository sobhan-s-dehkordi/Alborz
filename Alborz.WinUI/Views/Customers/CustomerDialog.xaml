<ContentDialog RequestedTheme="{Binding RequestedTheme, Source={StaticResource Appearance}}"
 FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}"    x:Class="Alborz.WinUI.Views.Customers.CustomerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind DialogTitle}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" Width="400" Margin="0,16,0,0">

        <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" />

        <TextBox FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Header="Full Name *" 
                 Text="{x:Bind CustomerName, Mode=TwoWay}" 
                 PlaceholderText="e.g. Ali Rezaei"/>

        <TextBox FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Header="Phone Number *" 
                 Text="{x:Bind PhoneNumber, Mode=TwoWay}" 
                 PlaceholderText="e.g. 09123456789"
                 MaxLength="11"/>

        <TextBox FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Header="National Code" 
                 Text="{x:Bind NationalCode, Mode=TwoWay}" 
                 PlaceholderText="10-digit code"
                 MaxLength="10"/>

    </StackPanel>
</ContentDialog>


