<ContentDialog
    x:Class="Alborz.WinUI.Views.Parties.PartyEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Party Details"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" Width="350" Padding="0,16,0,0">
        <TextBox x:Name="NameTextBox" Header="Full Name" PlaceholderText="e.g. John Doe / ABC Company"/>
        <TextBox x:Name="PhoneTextBox" Header="Phone Number" PlaceholderText="e.g. +1 234 567 8900"/>

        <TextBlock Text="Role in System:" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="24">
            <CheckBox x:Name="SupplierCheckBox" Content="Supplier"/>
            <CheckBox x:Name="CustomerCheckBox" Content="Customer"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>