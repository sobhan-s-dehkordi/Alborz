<Page
    x:Class="Alborz.WinUI.Views.SalesInvoices.SalesHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Alborz.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Filter Section -->
        <Border Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox Grid.Column="0" 
                                Header="Customer" 
                                Text="{x:Bind ViewModel.SearchCustomerText, Mode=TwoWay}" 
                                ItemsSource="{x:Bind ViewModel.CustomerSearchResults, Mode=OneWay}"
                                TextChanged="CustomerSearchBox_TextChanged"
                                SuggestionChosen="CustomerSearchBox_SuggestionChosen"
                                TextMemberPath="Name"
                                UpdateTextOnSelect="False"
                                PlaceholderText="Search customer...">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding PhoneNumber}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <CalendarDatePicker Grid.Column="1" 
                                    Header="From Date" 
                                    Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select date"/>

                <CalendarDatePicker Grid.Column="2" 
                                    Header="To Date" 
                                    Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" 
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Select date"/>

                <TextBox Grid.Column="3" 
                         Header="Invoice ID" 
                         Text="{x:Bind ViewModel.InvoiceIdFilter, Mode=TwoWay}" 
                         PlaceholderText="e.g. 1005"/>

                <Button Grid.Column="4" 
                        Content="Search" 
                        Command="{x:Bind ViewModel.SearchInvoicesCommand}" 
                        VerticalAlignment="Bottom" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        Width="100"/>
            </Grid>
        </Border>

        <!-- 2. DataGrid Section -->
        <controls:DataGrid Grid.Row="1"
                           ItemsSource="{x:Bind ViewModel.Invoices, Mode=OneWay}"
                           SelectedItem="{x:Bind ViewModel.SelectedInvoice, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           CanUserSortColumns="True"
                           HeadersVisibility="Column"
                           GridLinesVisibility="Horizontal"
                           SelectionMode="Single">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Inv ID" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate}" Width="120" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="150" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="200" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="120" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Discount" Binding="{Binding TotalDiscount, Converter={StaticResource CurrencyConverter}}" Width="100" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Add. Charges" Binding="{Binding AdditionalCharges, Converter={StaticResource CurrencyConverter}}" Width="110" IsReadOnly="True"/>
                <controls:DataGridTextColumn Header="Net Payable" Binding="{Binding NetAmount, Converter={StaticResource CurrencyConverter}}" Width="130" IsReadOnly="True"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- 3. Footer Section (Summaries and Actions) -->
        <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Total:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalAmountSummary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Discount:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalDiscountSummary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="14" FontWeight="SemiBold" Foreground="IndianRed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Add. Charges:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalAdditionalChargesSummary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="14" FontWeight="SemiBold" Foreground="SeaGreen"/>
                    </StackPanel>

                    <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="NET:" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalNetAmountSummary, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">

                    <Button Content="Export to Excel" 
                            Command="{x:Bind ViewModel.ExportToExcelCommand}" 
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.HasInvoices, Mode=OneWay}"
                            Width="120"/>

                    <Button Content="Details" 
                            Command="{x:Bind ViewModel.ViewDetailsCommand}" 
                            IsEnabled="{x:Bind ViewModel.IsInvoiceSelected, Mode=OneWay}"
                            Width="120"/>

                    <Button Content="Edit" 
                            Command="{x:Bind ViewModel.EditInvoiceCommand}" 
                            IsEnabled="{x:Bind ViewModel.IsInvoiceSelected, Mode=OneWay}"
                            Width="120"/>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>