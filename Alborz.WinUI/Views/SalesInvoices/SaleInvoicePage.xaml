<Page
    x:Class="Alborz.WinUI.Views.SalesInvoices.SaleInvoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Alborz.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="16">

                <!-- سرچ مشتری + دکمه ثبت سریع -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <AutoSuggestBox Header="Customer (Optional)" 
                                    Text="{x:Bind ViewModel.SearchCustomerText, Mode=TwoWay}" 
                                    ItemsSource="{x:Bind ViewModel.CustomerSearchResults, Mode=OneWay}"
                                    TextChanged="CustomerSearchBox_TextChanged"
                                    SuggestionChosen="CustomerSearchBox_SuggestionChosen"
                                    TextMemberPath="Name" 
                                    UpdateTextOnSelect="False"
                                    Width="250"
                                    PlaceholderText="Search customer...">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding PhoneNumber}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <Button VerticalAlignment="Bottom" Height="32" Width="36" Padding="0" ToolTipService.ToolTip="Quick Register Customer">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="12" Width="250">
                                    <TextBlock Text="Quick Register" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBox Header="Name *" Text="{x:Bind ViewModel.NewCustomerName, Mode=TwoWay}" PlaceholderText="Full name"/>
                                    <TextBox Header="Phone *" Text="{x:Bind ViewModel.NewCustomerPhone, Mode=TwoWay}" PlaceholderText="09..."/>
                                    <TextBox Header="National Code" Text="{x:Bind ViewModel.NewCustomerNationalCode, Mode=TwoWay}"/>
                                    <Button Content="Save &amp; Select" 
                                            Command="{x:Bind ViewModel.QuickRegisterCustomerCommand}" 
                                            Style="{ThemeResource AccentButtonStyle}" 
                                            HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <CalendarDatePicker Header="Invoice Date" 
                                    Date="{x:Bind ViewModel.InvoiceDate, Mode=TwoWay}" 
                                    HorizontalAlignment="Stretch"/>

                <ComboBox Header="Payment Method" 
                          ItemsSource="{x:Bind ViewModel.PaymentMethods, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPaymentMethod, Mode=TwoWay}"
                          Width="200"/>
            </StackPanel>
        </Border>

        <!-- 2. Item Entry Section -->
        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <!-- 0: Search Product -->
                        <ColumnDefinition Width="80"/>
                        <!-- 1: Qty -->
                        <ColumnDefinition Width="130"/>
                        <!-- 2: Unit Price -->
                        <ColumnDefinition Width="130"/>
                        <!-- 3: Discount -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- 4: Button -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <AutoSuggestBox Header="Search Product" 
                                        Text="{x:Bind ViewModel.SearchProductText, Mode=TwoWay}" 
                                        ItemsSource="{x:Bind ViewModel.ProductSearchResults, Mode=OneWay}"
                                        TextChanged="ProductSearchBox_TextChanged"
                                        SuggestionChosen="ProductSearchBox_SuggestionChosen"
                                        TextMemberPath="Name" 
                                        UpdateTextOnSelect="False" 
                                        Width="270"
                                        PlaceholderText="Type to search...">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Id}" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                    </StackPanel>

                    <TextBox Grid.Column="1" Header="Qty" Text="{x:Bind ViewModel.InputQuantity, Mode=TwoWay}"/>

                    <TextBox Grid.Column="2" Header="Unit Price" Text="{x:Bind ViewModel.InputPrice, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" IsReadOnly="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <TextBox Grid.Column="3" Header="Discount (%)" Text="{x:Bind ViewModel.InputDiscountPercentage, Mode=TwoWay}" PlaceholderText="e.g. 5, 10"/>

                    <Button Grid.Column="4" Content="Add to Invoice" Command="{x:Bind ViewModel.AddToInvoiceCommand}" VerticalAlignment="Bottom" Style="{ThemeResource AccentButtonStyle}" Width="150"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- 3. DataGrid Section -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <controls:DataGrid ItemsSource="{x:Bind ViewModel.InvoiceItems, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" MinWidth="250"/>
                    <controls:DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                    <controls:DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="120"/>
                    <controls:DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" Width="100"/>
                    <controls:DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="140"/>
                    <controls:DataGridTemplateColumn Width="70">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Foreground="IndianRed" Click="RemoveItemButton_Click" ToolTipService.ToolTip="Remove item">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <!-- 4. Footer Section -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBox Header="Global Discount" Text="{x:Bind ViewModel.TotalDiscount, Mode=TwoWay}" TextChanging="Currency_TextChanging" Width="180" />
                        <TextBox Header="Additional Charges" Text="{x:Bind ViewModel.AdditionalCharges, Mode=TwoWay}" TextChanging="Currency_TextChanging" Width="220" />
                    </StackPanel>
                    <TextBox Header="Remarks / Notes" Text="{x:Bind ViewModel.Remarks, Mode=TwoWay}" Width="416" Height="80" TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="Enter any notes here..."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <Grid>
                        <TextBlock Text="Total Amount:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Total Line Discounts:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalLineDiscounts, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="IndianRed" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Overall Discount:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.OverallTotalDiscount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="IndianRed" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Additional Charges:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Text="{x:Bind ViewModel.AdditionalChargesValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="SeaGreen" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="14"/>
                    </Grid>
                    <MenuFlyoutSeparator Margin="0,6" />
                    <Grid>
                        <TextBlock Text="Net Payable:" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.NetAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveInvoiceCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="48" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>