<Page x:Class="Alborz.WinUI.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="20" MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
            <Border Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Changes apply immediately to the application and are saved automatically." TextWrapping="Wrap"/>
                    <ComboBox Header="Theme" ItemsSource="{x:Bind ViewModel.Themes}"
                              SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{x:Bind ViewModel.AppearanceStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                    <Button Content="Restore default appearance" Command="{x:Bind ViewModel.ResetAppearanceCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
