<Page FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" x:Class="Alborz.WinUI.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="20" MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="Settings" FontSize="28" FontWeight="SemiBold"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" IsClosable="False" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
            <Border Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="Appearance" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="Changes apply immediately to the application and are saved automatically." TextWrapping="Wrap"/>
                    <ComboBox FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Header="Theme" ItemsSource="{x:Bind ViewModel.Themes}"
                              SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    <ComboBox FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Header="Font — installed on this computer" ItemsSource="{x:Bind ViewModel.FontFamilies}"
                              SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              MaxDropDownHeight="360"/>
                    <Slider Header="Text size" Minimum="12" Maximum="24" StepFrequency="1" TickFrequency="2"
                            TickPlacement="Outside" Value="{x:Bind ViewModel.SelectedFontSize, Mode=TwoWay}"/>
                    <Border Padding="20" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="Preview" FontWeight="SemiBold"/>
                            <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="The quick brown fox — 0123456789" TextWrapping="Wrap"/>
                            <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="????????? ???? — ????????? ?????? ??????? ????? — ??????????"
                                       FlowDirection="RightToLeft" TextWrapping="Wrap"/>
                            <Button FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Content="Sample button" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="{x:Bind ViewModel.AppearanceStatus, Mode=OneWay}" TextWrapping="Wrap"/>
                    <Button FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Content="Restore default appearance" Command="{x:Bind ViewModel.ResetAppearanceCommand}"/>
                </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="Database" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="{x:Bind ViewModel.ServerInfo}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="To change the connection, set ALBORZ_SQLSERVER_CONNECTION before launching the application, then restart. Use Windows authentication where possible." TextWrapping="Wrap"/>
                    <Button FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Content="Test connection" Command="{x:Bind ViewModel.TestConnectionCommand}"/>
                    <TextBlock FontSize="{Binding FontSize, Source={StaticResource Appearance}}" FontFamily="{Binding FontFamily, Source={StaticResource Appearance}}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

