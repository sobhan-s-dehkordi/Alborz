<Page
    x:Class="Alborz.WinUI.Views.Products.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Alborz.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">


    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter" />
    </Page.Resources>


    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" 
        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
        BorderThickness="1" 
        CornerRadius="8" 
        Padding="16">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                 Header="Product Name" 
                 Text="{x:Bind ViewModel.SearchName, Mode=TwoWay}" 
                 PlaceholderText="Search by name..."/>

                <TextBox Grid.Column="1" 
                 Header="Barcode" 
                 Text="{x:Bind ViewModel.SearchBarcode, Mode=TwoWay}" 
                 TextChanging="NumericOnly_TextChanging" 
                 PlaceholderText="Scan or type..."/>

                <TextBox Grid.Column="2" 
                 Header="Code (From)" 
                 Text="{x:Bind ViewModel.SearchCodeFrom, Mode=TwoWay}" 
                 TextChanging="NumericOnly_TextChanging"
                 PlaceholderText="Min"/>

                <TextBox Grid.Column="3" 
                 Header="Code (To)" 
                 Text="{x:Bind ViewModel.SearchCodeTo, Mode=TwoWay}" 
                 TextChanging="NumericOnly_TextChanging"
                 PlaceholderText="Max"/>

                <Button Grid.Column="4" 
                Command="{x:Bind ViewModel.LoadProductsCommand}" 
                Style="{ThemeResource AccentButtonStyle}" 
                VerticalAlignment="Bottom"
                Width="100">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Search" Margin="0,0,0,2"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <controls:DataGrid x:Name="ProductsDataGrid"
                               ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}" 
                               SelectedItem="{x:Bind ViewModel.SelectedProduct, Mode=TwoWay}"
                               AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                               GridLinesVisibility="Horizontal" AlternatingRowBackground="{ThemeResource SystemControlBackgroundAltHighBrush}">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Code (ID)" Binding="{Binding Id}" Width="100"/>
                    <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="250"/>
                    <controls:DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="150"/>
                    <controls:DataGridTextColumn Header="Purchase Price" Binding="{Binding PurchasePrice, Converter={StaticResource CurrencyConverter}}" Width="120"/>
                    <controls:DataGridTextColumn Header="Sell Price" Binding="{Binding SellPrice, Converter={StaticResource CurrencyConverter}}" Width="120"/>
                    <controls:DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="100"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Edit Selected" Click="EditProduct_Click" IsEnabled="{x:Bind ViewModel.IsProductSelected, Mode=OneWay}" Width="120"/>
            <Button Content="Create New" Click="CreateProduct_Click" Style="{ThemeResource AccentButtonStyle}" Width="120"/>
        </StackPanel>
    </Grid>
</Page>