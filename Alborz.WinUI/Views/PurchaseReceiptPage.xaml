<Page
    x:Class="Alborz.WinUI.Views.PurchaseReceiptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:Alborz.WinUI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyConverter" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header: Supplier -->
            <RowDefinition Height="Auto"/>
            <!-- Scanner & Add -->
            <RowDefinition Height="*"/>
            <!-- Receipt Items Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer: Total & Save -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="New Purchase Receipt" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <TextBox Header="Supplier Name" Text="{x:Bind ViewModel.SupplierName, Mode=TwoWay}" Width="250" Margin="32,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- SCANNER & INPUT BAR -->
        <Border Grid.Row="1" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Header="Scan Barcode" Text="{x:Bind ViewModel.ScannedBarcode, Mode=TwoWay}" PlaceholderText="Press Enter to find..." KeyDown="Barcode_KeyDown"/>

                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentProductName, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,8" FontWeight="SemiBold"/>

                <TextBox Grid.Column="2" Header="Qty" Text="{x:Bind ViewModel.InputQuantity, Mode=TwoWay}" TextChanging="NumericOnly_TextChanging"/>

                <TextBox Grid.Column="3" Header="Buy Price" Text="{x:Bind ViewModel.InputPrice, Mode=TwoWay}" TextChanging="Currency_TextChanging"/>

                <Button Grid.Column="4" Content="Add to Receipt" Command="{x:Bind ViewModel.AddToReceiptCommand}" VerticalAlignment="Bottom" Style="{ThemeResource AccentButtonStyle}"/>
            </Grid>
        </Border>

        <!-- STATUS MESSAGE -->
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="Red" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-25,0,0"/>

        <!-- RECEIPT ITEMS DATAGRID -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <controls:DataGrid ItemsSource="{x:Bind ViewModel.ReceiptItems, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                    <controls:DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="100"/>
                    <controls:DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="150"/>
                    <controls:DataGridTextColumn Header="Total Price" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="150"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <!-- FOOTER: TOTAL & SUBMIT -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                <TextBlock Text="Total Amount:" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.TotalReceiptAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                           Style="{ThemeResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseHighBrush}"/>
            </StackPanel>

            <Button Content="Save Final Receipt" Command="{x:Bind ViewModel.SaveReceiptCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" Width="180" Height="40"/>
        </Grid>
    </Grid>
</Page>